{
  "name": "dsh-window-state",
  "version": "0.2.0",
  "description": "记住 DSH Desktop 主窗口的位置、尺寸与最大化状态，重开原样恢复 / Remembers the DeepSeek Harness desktop window geometry (position, size, maximized) and restores it on the next launch.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/china-wkz/dsh-window-state.git"
  },
  "homepage": "https://github.com/china-wkz/dsh-window-state#readme",
  "bugs": {
    "url": "https://github.com/china-wkz/dsh-window-state/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "window-state.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.en.md",
    "assets/icon-180.png",
    "helper/window-state.cs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "window",
    "bounds",
    "geometry",
    "desktop"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
